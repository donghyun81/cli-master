; EditorConfig — 공통 에디터 설정 (app-neutral)
; 스펙: https://editorconfig.org
; 이 파일은 multi-repo propagation 대상이며 byte-identical 로 복사된다.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_packages_to_use_import_on_demand = unset
ktlint_standard = enabled

[{*.gradle,*.gradle.kts}]
indent_size = 4

[*.{xml,svg}]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[{Makefile,*.mk}]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.{properties,cfg,ini}]
indent_size = 2
